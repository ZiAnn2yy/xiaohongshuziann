{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://content-reverse-lab.local/schemas/analysis-request.json",
  "type": "object",
  "required": ["sourceText", "platform", "tone", "audienceLevel"],
  "properties": {
    "sourceText": { "type": "string", "minLength": 80, "maxLength": 1200 },
    "platform": { "type": "string", "enum": ["douyin", "xiaohongshu"] },
    "tone": { "type": "string", "enum": ["rational", "emotional", "storytelling"] },
    "audienceLevel": { "type": "string", "enum": ["beginner", "intermediate"] }
  },
  "additionalProperties": false
}
